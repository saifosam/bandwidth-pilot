// Windows resources: icon, manifest (administrator + DPI awareness) and version info.
// Compiled into cmd/bandwidthpilot/rsrc_windows_amd64.syso by build.sh / build.ps1.
1 ICON "bandwidthpilot.ico"
1 24 "bandwidthpilot.exe.manifest"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Saif Moataz Osam"
      VALUE "FileDescription", "Bandwidth Pilot"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "Bandwidth Pilot"
      VALUE "OriginalFilename", "BandwidthPilot.exe"
      VALUE "ProductName", "Bandwidth Pilot"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
